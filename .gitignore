# Large legacy 5m feature matrices (research/abandoned_models/) -- 5m is not
# part of the current production system. Regenerable via the archived
# refresh_features.py / features.py pipeline if ever needed again.
Data/features_out.csv
Data/features_out_masked.csv

# research_archive/Data/: cached outputs of the earliest (pre-v16) research
# scripts, 4.1GB. The scripts themselves are tracked under research/; this
# cache is regenerable by rerunning them and is kept locally, not in git.
research_archive/Data/

# Large regenerable research caches (per-bar decodes, chart data, full
# feature parquets). The small summary/report artifacts each experiment
# produced ARE tracked under research/ -- only the large raw caches are
# excluded here.
research/**/*_predictions_oos.csv
research/**/features_expanded_*.csv
research/**/master_oos_test_*.csv
research/**/expanded_hmm_cache/
research/ml_comparisons/rf_vs_lr/structure_features/

# Viz app: node_modules and build output (regenerate via `npm install`)
viz/frontend/node_modules/
viz/frontend/dist/

# Viz app + production: chart/feature caches regenerated on demand by
